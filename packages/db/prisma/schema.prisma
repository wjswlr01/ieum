// 이음 (Ieum) — Phase 2 양조 공정 관리 데이터베이스 스키마

generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────

enum Unit {
  KG
  G
  MG
  L
  ML
  PIECE
  PERCENT
  BX
  SRM
  IBU
  PH
  CELSIUS
  SG
}

enum BrewType {
  BEER
  MAKGEOLLI
  CHEONGJU
  SOJU
  FRUIT_WINE
}

enum UserRole {
  OWNER
  MANAGER
  BREWER
  VIEWER
}

enum NodeType {
  GRAIN_PREP
  MASH
  MASH_BEER
  BOIL
  FERMENTATION
  FILTERING
  CONDITIONING
  PACKAGING
  CUSTOM
}

enum BatchStatus {
  PLANNED
  IN_PROGRESS
  FERMENTING
  CONDITIONING
  PACKAGING
  COMPLETED
  ABORTED
}

enum MeasurementType {
  GRAVITY_ORIGINAL
  GRAVITY_FINAL
  TEMPERATURE
  PH
  ALCOHOL
  BRIX
  COLOR_SRM
  IBU
  DISSOLVED_OXYGEN
  TURBIDITY
  CUSTOM
}

enum IngredientCategory {
  GRAIN
  HOP
  YEAST
  NURUK
  RICE
  OTHER
}

enum TransactionType {
  IN
  OUT
  ADJUST
  PURCHASE
  BATCH_DEDUCT
  RESTORE
}

enum SharePermission {
  VIEW
  COPY
  EDIT
}

// ─── 테넌트 / 사용자 ──────────────────────────────────────────

// 1. tenants
model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  recipes            Recipe[]
  recipeTemplates    RecipeTemplate[]
  inventory          Inventory[]
  batches            Batch[]
  tenantGroupMembers TenantGroupMember[]
  accessMappings     AccessMapping[]
  notifications      Notification[]
  photos             Photo[]
  brewery            Brewery?

  @@index([slug])
}

// 2. users
model User {
  id                     String    @id @default(cuid())
  email                  String?   @unique
  emailVerified          DateTime?
  name                   String?
  image                  String?
  password               String? // 레거시 이메일 가입자 호환용 — 신규 가입자는 null
  role                   UserRole  @default(BREWER)
  tenantId               String? // 신규 OAuth 가입 직후 잠시 null (events.createUser에서 채움)
  tenant                 Tenant?   @relation(fields: [tenantId], references: [id])
  resetToken             String?   @unique
  resetTokenExp          DateTime?
  isAdmin                Boolean   @default(false)
  isActive               Boolean   @default(true)
  hasCompletedOnboarding Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  batches        Batch[]
  recipeShares   RecipeShare[]
  accessMappings AccessMapping[]
  tastingNotes   TastingNote[]
  notifications  Notification[]
  photos         Photo[]

  breweryReviews   BreweryReview[]
  breweryFavorites BreweryFavorite[]
  breweryPhotos    BreweryPhoto[]

  @@index([tenantId])
  @@index([email])
}

// 2b. NextAuth — Account / Session / VerificationToken
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── 레시피 ───────────────────────────────────────────────────

// 3. recipes
model Recipe {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  templateId   String?
  template     RecipeTemplate? @relation(fields: [templateId], references: [id])
  name         String
  brewType     BrewType        @default(BEER)
  version      Int             @default(1)
  description  String?
  targetVolume Float
  targetUnit   Unit            @default(L)
  isPublished  Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  nodes        RecipeNode[]
  ingredients  Ingredient[]
  batches      Batch[]
  recipeShares RecipeShare[]

  @@index([tenantId])
  @@index([templateId])
  @@index([tenantId, isPublished])
}

// 4. recipe_templates
model RecipeTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  isGlobal    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  recipes Recipe[]

  @@index([tenantId])
  @@index([isGlobal])
}

// 5. step_type_catalog
model StepTypeCatalog {
  id          String   @id @default(cuid())
  nodeType    NodeType @unique
  label       String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([nodeType])
  @@index([sortOrder])
}

// 6. recipe_nodes
model RecipeNode {
  id          String   @id @default(cuid())
  recipeId    String
  recipe      Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  nodeType    NodeType
  order       Int
  name        String
  description String?
  durationMin Int?
  targetTemp  Float?
  extraParams Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batchNodes            BatchNode[]
  recipeNodeIngredients RecipeNodeIngredient[]

  @@index([recipeId])
  @@index([recipeId, order])
}

// 7. ingredients
model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  recipe   Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name     String
  amount   Float
  unit     Unit
  notes    String?

  recipeNodeIngredients RecipeNodeIngredient[]
  batchIngredients      BatchIngredient[]

  @@index([recipeId])
}

// 7b. inventory_metadata — see Inventory model below

// ─── 재고 ─────────────────────────────────────────────────────

// 8. inventory
model Inventory {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  name         String
  category     IngredientCategory @default(OTHER)
  sku          String?
  quantity     Float              @default(0)
  unit         Unit
  reorderLevel Float?
  notes        String?
  metadata     Json?
  isCatalog    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  transactions     InventoryTransaction[]
  batchIngredients BatchIngredient[]

  @@index([tenantId])
  @@index([tenantId, sku])
}

// 9. inventory_transactions
model InventoryTransaction {
  id          String          @id @default(cuid())
  inventoryId String
  inventory   Inventory       @relation(fields: [inventoryId], references: [id])
  batchId     String?
  batch       Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  type        TransactionType
  quantity    Float
  notes       String?
  occurredAt  DateTime        @default(now())
  restoredAt  DateTime?

  @@index([inventoryId])
  @@index([inventoryId, occurredAt])
  @@index([batchId])
}

// ─── 배치 (실제 양조 기록) ────────────────────────────────────

// 10. batch_ingredients
model BatchIngredient {
  id           String      @id @default(cuid())
  batchId      String
  batch        Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchNodeId  String?
  batchNode    BatchNode?  @relation(fields: [batchNodeId], references: [id], onDelete: SetNull)
  ingredientId String?
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  inventoryId  String?
  inventory    Inventory?  @relation(fields: [inventoryId], references: [id])
  plannedAmt   Float
  actualAmt    Float?
  unit         Unit
  notes        String?

  @@index([batchId])
  @@index([batchNodeId])
  @@index([ingredientId])
  @@index([inventoryId])
}

// 11. batches
model Batch {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id])
  recipeId       String?
  recipe         Recipe?     @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  brewerId       String
  brewer         User        @relation(fields: [brewerId], references: [id])
  batchNumber    String      @unique
  status         BatchStatus @default(PLANNED)
  recipeSnapshot Json?
  actualVolume   Float?
  actualUnit     Unit?
  notes          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  batchNodes            BatchNode[]
  measurements          Measurement[]
  batchIngredients      BatchIngredient[]
  tastingNotes          TastingNote[]
  inventoryTransactions InventoryTransaction[]
  photos                Photo[]

  @@index([tenantId])
  @@index([recipeId])
  @@index([brewerId])
  @@index([tenantId, status])
  @@index([batchNumber])
}

// 12. batch_nodes
model BatchNode {
  id           String      @id @default(cuid())
  batchId      String
  batch        Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  recipeNodeId String?
  recipeNode   RecipeNode? @relation(fields: [recipeNodeId], references: [id], onDelete: SetNull)
  order        Int
  startedAt    DateTime?
  finishedAt   DateTime?
  actualTemp   Float?
  actualParams Json?
  notes        String?
  waterAddedMl Int?
  agingDays    Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  batchIngredients BatchIngredient[]
  photos           Photo[]

  @@index([batchId])
  @@index([recipeNodeId])
  @@index([batchId, order])
}

// 13. measurements
model Measurement {
  id      String          @id @default(cuid())
  batchId String
  batch   Batch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type    MeasurementType
  value   Float
  unit    Unit
  takenAt DateTime        @default(now())
  notes   String?

  @@index([batchId])
  @@index([batchId, type])
  @@index([batchId, takenAt])
}

// ─── 공유 / 접근 제어 ─────────────────────────────────────────

// 14. tasting_notes
model TastingNote {
  id       String @id @default(cuid())
  batchId  String
  batch    Batch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  tasterId String
  taster   User   @relation(fields: [tasterId], references: [id], onDelete: Cascade)

  appearance   Json?
  aromaGrain   Int     @default(0)
  aromaFruit   Int     @default(0)
  aromaNuruk   Int     @default(0)
  aromaHop     Int     @default(0)
  aromaAlcohol Int     @default(0)
  aromaOther   String?

  tasteSweet  Int @default(0)
  tasteSour   Int @default(0)
  tasteBitter Int @default(0)
  tasteUmami  Int @default(0)

  body        Int @default(0)
  carbonation Int @default(0)

  overallScore Int     @default(0)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([tasterId])
}

// 15. recipe_shares
model RecipeShare {
  id         String          @id @default(cuid())
  recipeId   String
  recipe     Recipe          @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  sharedById String
  sharedBy   User            @relation(fields: [sharedById], references: [id])
  permission SharePermission @default(VIEW)
  expiresAt  DateTime?
  createdAt  DateTime        @default(now())

  @@index([recipeId])
  @@index([sharedById])
}

// 15. access_mappings
model AccessMapping {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  role      UserRole
  grantedAt DateTime @default(now())

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
}

// ─── 테넌트 그룹 ──────────────────────────────────────────────

// 16. tenant_groups
model TenantGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TenantGroupMember[]

  @@index([name])
}

// 17. tenant_group_members
model TenantGroupMember {
  id            String      @id @default(cuid())
  tenantGroupId String
  tenantGroup   TenantGroup @relation(fields: [tenantGroupId], references: [id], onDelete: Cascade)
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  joinedAt      DateTime    @default(now())

  @@unique([tenantGroupId, tenantId])
  @@index([tenantGroupId])
  @@index([tenantId])
}

// 19. notifications
model Notification {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  type        String // LOW_STOCK, FERMENTATION_REMINDER, BATCH_STATUS
  title       String
  message     String
  isRead      Boolean  @default(false)
  referenceId String?
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([tenantId])
  @@index([createdAt])
}

// 20. photos — 배치별 사진 (admin 업로드, 전체 조회)
model Photo {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  batchId      String
  batch        Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchNodeId  String?
  batchNode    BatchNode? @relation(fields: [batchNodeId], references: [id], onDelete: SetNull)

  // Supabase Storage 경로만 저장 (signed URL은 조회 시 생성)
  originalPath String
  caption      String?
  capturedAt   DateTime
  fileSize     Int
  width        Int?
  height       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, capturedAt])
  @@index([tenantId])
  @@index([batchNodeId])
  @@index([uploadedById])
}

// 18. recipe_node_ingredients
model RecipeNodeIngredient {
  id           String     @id @default(cuid())
  recipeNodeId String
  recipeNode   RecipeNode @relation(fields: [recipeNodeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  amount       Float
  unit         Unit
  notes        String?

  @@unique([recipeNodeId, ingredientId])
  @@index([recipeNodeId])
  @@index([ingredientId])
}

// ─── 양조장 디렉토리 ──────────────────────────────────────────

// 21. breweries — 양조장 메인 정보 (공공데이터 + 양조사 보강)
model Brewery {
  id String @id @default(cuid())

  // 공공데이터 기반
  name           String
  address        String
  latitude       Float?
  longitude      Float?
  region         String
  city           String?
  website        String?
  businessNumber String?

  // 매칭 (양조사가 자기 양조장 등록 시)
  tenantId String? @unique
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // 양조사 자체 입력
  tagline           String? @db.VarChar(80)
  description       String? @db.Text
  operatingHours    Json?
  tourAvailable     Boolean @default(false)
  tourBookingMethod String?
  tastingAvailable  Boolean @default(false)
  tastingPriceInfo  String?
  parkingInfo       String?

  products  BreweryProduct[]
  photos    BreweryPhoto[]
  reviews   BreweryReview[]
  favorites BreweryFavorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([region])
  @@index([latitude, longitude])
  @@index([name])
}

// 22. brewery_products — 양조장 제품
model BreweryProduct {
  id        String  @id @default(cuid())
  breweryId String
  brewery   Brewery @relation(fields: [breweryId], references: [id], onDelete: Cascade)

  name           String
  brewType       BrewType?
  alcoholContent Float?
  volume         String?
  price          Int?
  imagePath      String?
  sortOrder      Int       @default(0)
  ingredients    String?   @db.Text
  features       String?   @db.Text
  awards         String?   @db.Text
  isAvailable    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([breweryId])
  @@index([breweryId, sortOrder])
  @@index([brewType])
}

// 23. brewery_photos — 양조장 사진 (양조사 업로드)
model BreweryPhoto {
  id        String  @id @default(cuid())
  breweryId String
  brewery   Brewery @relation(fields: [breweryId], references: [id], onDelete: Cascade)

  originalPath String
  caption      String?
  isPrimary    Boolean @default(false)
  sortOrder    Int     @default(0)

  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime @default(now())

  @@index([breweryId])
  @@index([breweryId, sortOrder])
  @@index([uploadedById])
}

// 24. brewery_reviews — 양조장 후기 (이음 가입자)
model BreweryReview {
  id        String  @id @default(cuid())
  breweryId String
  brewery   Brewery @relation(fields: [breweryId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  rating  Int
  content String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([breweryId, authorId])
  @@index([breweryId])
  @@index([authorId])
}

// 25. brewery_favorites — 즐겨찾기
model BreweryFavorite {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  breweryId String
  brewery   Brewery @relation(fields: [breweryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, breweryId])
  @@index([userId])
  @@index([breweryId])
}
